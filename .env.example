# Copy to .env and fill in the values. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The paid variant is more stable. The ":free" variant logs usage to improve
# NVIDIA products, so use it only with public and SYNTHETIC documents.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TEMPERATURE=0

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/copilot

# Optional: extra OpenRouter keys (comma-separated). Used in order when the key above hits the
# free-tier daily limit (HTTP 429 free-models-per-day). Never commit real keys.
OPENROUTER_API_KEYS=

# Optional: 0 = do not retrieve SYNTHETIC test documents in normal runs (saves extraction tokens; the real-mode
# memo never uses them, but SYNTHETIC trap questions then show nothing). Default 1.
RETRIEVE_SYNTHETIC=1
